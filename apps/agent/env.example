# Copy to .env.local for local development. Never commit real values.

# The billing system (the stub in this demo). Server-side only.
BILLING_API_URL=https://your-billing-stub.vercel.app
BILLING_API_TOKEN=replace-me

# Signs tool-approval requests so a client cannot forge an approval.
# Generate with: openssl rand -base64 32   (set in EVERY environment that runs the workflow)
WORKFLOW_TOOL_APPROVAL_SECRET=replace-me

# Local development only: AI Gateway key. Deployed on Vercel, the project's OIDC token
# is used instead (verify this in the AI Gateway docs for your account).
AI_GATEWAY_API_KEY=
